# Gradle / Kotlin
.gradle/
build/
!build-logic/
local.properties
captures/
.kotlin/
kotlin-js-store/

# Xcode / iOS
xcuserdata/
*.xcuserstate
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
iosApp/Pods/
iosApp/*.xcodeproj/project.xcworkspace/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip

# IDE
.idea/*
!.idea/codeStyles/
!.idea/runConfigurations/
*.iml
.fleet/

# Secrets — never commit these. See docs/secrets.md
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
keystore.properties
signing.properties
play-service-account*.json
appstore-api-key*.json
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png

# OS
.DS_Store
Thumbs.db

# Gradle wrapper jar is committed intentionally (standard practice)
!gradle/wrapper/gradle-wrapper.jar

# Local signing config — team ids are personal, keep them out of a public repo
iosApp/Local.xcconfig
iosApp/VITT.xcodeproj/
iosApp/build/

# Design handoff exports. Large binaries, re-exportable from Claude Design at
# any time, and the extracted content is what matters rather than the archive.
*-handoff.zip

# Xcode derived data from the simulator build loop.
iosApp/build-rel/
tools/__pycache__/
iosApp/build-device/

# Ephemeral worktrees from agent runs. These were committed as orphan
# gitlinks with no .gitmodules, which fails git on every fresh checkout.
.claude/worktrees/

# Scratch derived data from entitlement experiments.
iosApp/build-*/

# Playwright MCP scratch output — snapshots and console logs from ad-hoc
# browser checks. Never part of the build.
.playwright-mcp/

# /brag launch video: the scratch and the parts that are not ours to publish.
# The music track is ende.app's, redistributable in the rendered video the
# skill exists to make but not as a raw file in a public repo; re-renders copy
# it from the brag skill (see brag-output/composition-brief.md). The scaffold's
# own agent notes tell any agent to install Hyperframes skills, which would
# mislead an agent working on the app.
brag-output/snapshots/
brag-output/composition/assets/music/
brag-output/composition/AGENTS.md
brag-output/composition/CLAUDE.md
brag-output/composition/.hyperframes/
