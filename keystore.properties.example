# Release signing for the Android upload key. Copy to `keystore.properties`,
# which is gitignored, and fill in.
#
# Create the keystore yourself and back it up somewhere you will still have in
# five years. Play binds the listing to this key: lose it and that listing can
# never be updated again. Nothing in this repo will generate it for you, on
# purpose.
#
#   keytool -genkeypair -v -keystore vitt-upload.jks -alias vitt-upload \
#       -keyalg RSA -keysize 4096 -validity 10000
#
# Paths are relative to the repository root.
storeFile=vitt-upload.jks
storePassword=
keyAlias=vitt-upload
keyPassword=
