<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget sits on the user's wallpaper, not inside the app, so it follows the
  system rather than the app's chosen palette: a light card on a dark home screen
  is a glare source at the exact moment a glance is meant to cost nothing.

  Named from Palette.Cream, the light theme's own ground and ink.
-->
<resources>
    <color name="widget_ground">#FBF8F1</color>
    <color name="widget_ink">#1C1826</color>
    <color name="widget_ink_muted">#6B6478</color>
    <color name="widget_accent">#6C4CF1</color>
    <color name="widget_on_accent">#FFFFFF</color>
</resources>
